# Copy this file to .env and fill in your keys. .env is gitignored. Never commit real keys.

# --- Primary: OpenRouter (free models) ---
OPENROUTER_API_KEY=
# Optional. Comma-separated model ids, best first (only the first 3 are sent per request).
# Leave empty to auto-pick free models that support tool calling. Models 4-6 form a second
# chain on the same key, tried before the FALLBACK_* provider below.
OPENROUTER_MODELS=

# --- Fallback: any OpenAI-compatible chat completions API ---
# Used when OpenRouter fails or is rate limited. Examples of base URLs:
#   Groq:    https://api.groq.com/openai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Together: https://api.together.xyz/v1
#   A second OpenRouter account: https://openrouter.ai/api/v1
FALLBACK_NAME=fallback
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# --- Observability (optional): trace every run in Langfuse ---
# Free account at https://cloud.langfuse.com, or point LANGFUSE_HOST at a self-hosted instance.
# Leave either key blank to skip tracing entirely (no network call, no import of langfuse).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
